class Solution {
  public:
    void pushZerosToEnd(vector<int>& arr) {
        // code here
        int  n = arr.size();
        vector<int>temp;
        vector<int>ans;
        for(int i =0;i<n;i++){
            if(arr[i] == 0)  temp.push_back(arr[i]);
        }
        
        for(int i =0;i<n;i++){
            if(arr[i] != 0)  
            ans.push_back(arr[i]);
        }
       for(int j =0;j<temp.size();j++){
           ans.push_back(temp[j]);
       }
       arr = ans;
    }
};
