Missing Element in Range:
 vector<int> missinRange(vector<int>& arr, int low, int high) {
    vector<int> ans;
    int n = arr.size();

   unordered_map<int,int>mp;
   for(int x : arr){
       mp[x]++;
       
   }
   for(int i = low;i<= high;i++){
       if(mp.find(i) == mp.end()){
           ans.push_back(i);
       }
   }
    return ans;
}
};
TIME COMPLEXITY - O(N+R) WHERE R = LOW-HIGH+1
SPACE COMPLEXITY = O(N) FOR USING HASHING
