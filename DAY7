Form the Largest Number
class Solution {
  public:
    string findLargest(vector<int> &arr) {
        // code here
        int n = arr.size();
        vector<string>ans;
        for(int i =0;i<n;i++){
            ans.push_back(to_string(arr[i]));
        }
        
      sort(ans.begin(), ans.end(), [](string &a, string &b){
        return a + b > b + a;
    });
        if (ans[0] == "0") return "0";
        string res = "";
        for(string &s : ans){
            res+= s;
        }
        return res;
    }
};
TIME COMPLEXITY - O(NLOGN)
SPACE COMPLEXITY - O(N) 
