Union of Arrays with Duplicates
vector<int> findUnion(vector<int>& a, vector<int>& b) {
    map<int, int> mp1;
    map<int, int> mp2;
    vector<int> ans;

    
    for (int i = 0; i < a.size(); i++) {
        mp1[a[i]]++; 
    }

   
    for (int i = 0; i < b.size(); i++) {
        mp2[b[i]]++;
    }

    
    for (auto p : mp1) {
        ans.push_back(p.first);
    }

   
    for (auto p : mp2) {
        int elementFromB = p.first;
        
        
        if (mp1.find(elementFromB) == mp1.end()) {
            ans.push_back(elementFromB);
        }
    }

  
    sort(ans.begin(), ans.end());

    return ans;
}
};
